# Environment: development | production | test
NODE_ENV="development"

# Port the server listens on
PORT="5000"

# Postgres connection string (must be a valid connection URL)
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce"

# Comma-separated list of origins allowed to make credentialed
# requests to this API (no spaces needed, but trimmed either way)
CORS_ORIGINS="http://localhost:3000,https://your-frontend.example.com"

# Name of the session cookie
SESSION_COOKIE_NAME="sid"

# Secret used to hash session tokens - at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET="replace-with-a-real-random-32+-character-secret"

# Sliding session expiry, in milliseconds (e.g. 604800000 = 7 days)
SESSION_MAX_AGE="604800000"

# Absolute session expiry, in milliseconds (e.g. 2592000000 = 30 days)
SESSION_ABSOLUTE_MAX_AGE="2592000000"